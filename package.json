{
  "name": "tyto-desktop",
  "productName": "Tyto",
  "version": "1.0.0-beta.4",
  "description": "tyto.chat desktop app",
  "homepage": "https://tyto.chat",
  "author": "tyto.chat",
  "license": "MIT",
  "private": true,
  "desktopName": "tyto.desktop",
  "main": "app/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:client": "bash scripts/build-client.sh",
    "dev": "npm run build && electron .",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && TYTO_ALLOW_INSECURE_KEYCHAIN=1 electron scripts/smoke-main.js",
    "icons": "bash scripts/make-icons.sh",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:arch": "npm run build && electron-builder --linux pacman --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}

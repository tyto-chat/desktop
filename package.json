{
  "name": "tyto-desktop",
  "productName": "tyto",
  "version": "0.1.0",
  "description": "tyto.chat desktop app",
  "homepage": "https://tyto.chat",
  "author": "tyto.chat",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "main": "app/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:client": "bash scripts/build-client.sh",
    "dev": "npm run build && electron .",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "electron": "^44.4.5",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^4.1.11"
  }
}
